server {
    listen 80;
    listen [::]:80;

    server_name _;

    root /var/www/my-web/html;
    index index.html index.htm;

    # Cấu hình chuyển hướng mã lỗi 404 tới trang tùy chỉnh /404.html
    error_page 404 /404.html;

    # Xử lý các request thông thường
    location / {
        try_files $uri $uri/ =404;
    }

    # Cấu hình bảo vệ trang lỗi 404 tùy biến
    # Chỉ thị 'internal' đảm bảo người dùng từ internet không thể truy cập trực tiếp URL /404.html
    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}
